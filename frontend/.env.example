# Local dev: backend on port 4000 (rewrites proxy /api when NEXT_PUBLIC_API_URL is unset)
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Required on Vercel for real-time generation progress (your deployed backend URL)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Vercel only — server-side proxy for /api (do not prefix with NEXT_PUBLIC_)
# API_URL=https://your-backend.railway.app
